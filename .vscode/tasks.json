{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "xmake",
            "args": [
                "f",
                "-p",
                "windows",
                "-a",
                "x86",
                "-m",
                "debug",
                "-y"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "xmake",
            "args": [
                "f",
                "-p",
                "windows",
                "-a",
                "x86",
                "-m",
                "release",
                "-y"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Compile",
            "type": "shell",
            "command": "xmake",
            "args": [
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}