{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "xmake",
            "args": [
                "dev",
                "-m",
                "debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "xmake",
            "args": [
                "dev",
                "-m",
                "release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Compile",
            "type": "shell",
            "command": "xmake",
            "args": [
                "build"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "xmake",
            "args": [
                "clean"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run GTA SA",
            "type": "shell",
            "command": "Start-Process 'D:\\Games\\GTA San Andreas\\gta_sa.exe' -WorkingDirectory 'D:\\Games\\GTA San Andreas'",
            "problemMatcher": []
        },
        {
            "label": "Build & Run GTA SA",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug",
                "Run GTA SA"
            ],
            "problemMatcher": []
        }
    ]
}