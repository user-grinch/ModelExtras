CompileFlags:
  Add:
    - "--target=i686-pc-windows-msvc"
    - "-m32"
    - "-I"
    - "D:/Dev/plugin-sdk"
    - "-I"
    - "D:/Dev/plugin-sdk/plugin_sa"
    - "-I"
    - "D:/Dev/plugin-sdk/plugin_sa/game_sa"
    - "-I"
    - "D:/Dev/plugin-sdk/plugin_sa/game_sa/enums"
    - "-I"
    - "D:/Dev/plugin-sdk/plugin_sa/game_sa/meta"
    - "-I"
    - "D:/Dev/plugin-sdk/plugin_sa/game_sa/rw"
    - "-I"
    - "D:/Dev/plugin-sdk/shared"
    - "-I"
    - "D:/Dev/plugin-sdk/shared/game"
    - "-I"
    - "D:/Dev/plugin-sdk/injector"
    - "-I"
    - "D:/Dev/plugin-sdk/safetyhook"
    - "-I"
    - "D:/Dev/Modding/ModelExtras/src"
    - "-I"
    - "D:/Dev/Modding/ModelExtras/include"
    - "-I"
    - "D:/Dev/Modding/ModelExtras/src/features"
    - "-I"
    - "D:/Dev/Modding/ModelExtras"
    - "-I"
    - "src"
    - "-I"
    - "include"
    - "-I"
    - "src/features"
    - "-I"
    - "."
    - "-std=c++latest"
    - "-DPLUGIN_SGV_10US"
    - "-DMODELEXTRAS_DEV"
    - "-DGTASA"
    - "-DRW"
    - "-DNOMINMAX"
    - "-DWIN32_LEAN_AND_MEAN"
    - "-D_USE_MATH_DEFINES"
    - "-Wno-unused-command-line-argument"
  Remove:
    - "/Yu*"
    - "/Fp*"
    - "/FI*"
    - "-Yu*"
    - "-Fp*"
    - "-FI*"
